# ローカル開発用の環境変数テンプレート。
# 使い方:
#   Copy-Item .env.example .env
#   .env 内の DATABASE_URL を自分の PostgreSQL に合わせて編集する。
#
# 注意: .env は Git にコミットしない（.gitignore 済み）。
# 本番サーバーやタスクスケジューラでは、OS の環境変数で DATABASE_URL を設定する運用を推奨。

# PostgreSQL 接続 URL（psycopg / libpq 形式）
# 形式: postgresql://postgres:パスワード@ホスト:ポート/データベース名
#   postgres … インストール時に自動作成されるユーザー名（入力欄はパスワードのみ）
#   パスワード … インストールウィザードで設定したもの
#   lab_management_dev … 任意の DB 名（db-init が無ければ作成する）
DATABASE_URL=postgresql://postgres:password@localhost:5432/lab_management_dev

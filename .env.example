# ローカル開発用の環境変数テンプレート。
# 使い方:
#   Copy-Item .env.example .env
#   .env 内の DATABASE_URL / API_KEY などを自分の環境に合わせて編集する。
#
# 注意: .env は Git にコミットしない（.gitignore 済み）。
# 本番サーバーやタスクスケジューラでは、OS の環境変数で設定する運用を推奨。

# PostgreSQL 接続 URL（psycopg / libpq 形式）
# 形式: postgresql://postgres:パスワード@ホスト:ポート/データベース名
#   postgres … インストール時に自動作成されるユーザーID（入力欄はパスワードのみ）
#   パスワード … インストールウィザードで設定したもの
#   lab_management_dev … 任意の DB 名（db-init が無ければ作成する）
DATABASE_URL=postgresql://postgres:password@localhost:5432/lab_management_dev

# VS Code 拡張などからの在室・作業 API 用の共有キー（長いランダム文字列）
API_KEY=change-me-to-a-long-random-secret

# Slack Sign in with Slack（OpenID Connect）
# https://api.slack.com/authentication/sign-in-with-slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://サーバーIP:ポート/auth/slack/callback

# セッション Cookie 署名用（本番ではランダムな長い文字列を自由に設定）
SESSION_SECRET=
